# Copie para .env.local e preencha. Na Vercel: Settings → Environment Variables.

# ── Site ─────────────────────────────────────────────────────────────
# Domínio público (sem barra no final). Sem ela, vale adrieldev.vercel.app.
# Atenção: adriel.dev pertence a outra pessoa — não use.
NEXT_PUBLIC_SITE_URL=https://adrieldev.vercel.app

# ── Sanity (leitura pública) ─────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Token dos scripts (seed/publish-post). Não é usado pelo site.
SANITY_API_TOKEN=

# ── Módulo de contato (/api/mensagem) ────────────────────────────────
# Cada destino liga sozinho quando a variável existe. Configure ao menos um.

# 1) Sanity — as mensagens aparecem em /studio → 📨 Mensagens.
#    sanity.io/manage → API → Tokens → Add API token → permissão "Editor".
SANITY_WRITE_TOKEN=

# 2) Planilha Google (opcional) — URL do Web App do Apps Script (ver SETUP-SANITY.md).
SHEETS_WEBHOOK_URL=

# 3) Notificação no celular (opcional) — webhook do Discord ou Slack.
CONTACT_WEBHOOK_URL=
